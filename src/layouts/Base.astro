---
import '@fontsource/gentium-book-plus/400.css';
import '@fontsource/gentium-book-plus/400-italic.css';
import '@fontsource/gentium-book-plus/700.css';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/manuscript.css';

interface Props {
  title: string;
  description: string;
  path: string;
  og: string;
  type?: 'website' | 'article';
  wide?: boolean;
}
const { title, description, path, og, type = 'website', wide = false } = Astro.props;
const url = new URL(path, Astro.site).href;
const image = new URL(og, Astro.site).href;
const fullTitle = path === '/' ? 'Śāstras — a map of Indian philosophy and the classical sciences' : `${title} · Śāstras`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Śāstras" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#e4dcc4" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1c1914" media="(prefers-color-scheme: dark)" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class:list={['site-head', { wide }]}>
      <a class="site-name" href="/">Śāstras</a>
      <span class="hole" aria-hidden="true"></span>
    </header>
    <main id="main" class:list={['page', { wide }]}><slot /></main>
    <footer class:list={['site-foot', { wide }]}>
      <span class="danda" aria-hidden="true">॥</span>
      <p>Drafted from public sources; every page lists its own. <a href="/about">About this map</a> · <a href="/glossary">Glossary</a> · <a href="https://github.com/dhanjit/sastras">Source on GitHub</a></p>
    </footer>
    <script>
      const pop = document.createElement('div');
      pop.id = 'gloss-pop';
      pop.setAttribute('aria-hidden', 'true'); // visual only; each term carries its own description (Task 9)
      pop.hidden = true;
      document.body.append(pop);
      let current: HTMLElement | null = null;

      function place(term: HTMLElement) {
        pop.style.left = '0px'; // measure at the origin, not at the last position
        pop.style.top = '0px';
        pop.hidden = false;
        const r = term.getBoundingClientRect();
        const w = pop.offsetWidth;
        const h = pop.offsetHeight;
        const vw = document.documentElement.clientWidth;
        const left = Math.max(8, Math.min(r.left, vw - w - 8));
        const below = r.bottom + h + 8 <= innerHeight || r.top < h + 8;
        pop.dataset.side = below ? 'below' : 'above';
        pop.style.left = `${left + scrollX}px`;
        pop.style.top = `${(below ? r.bottom : r.top - h) + scrollY}px`;
      }
      function show(term: HTMLElement) {
        current = term;
        const b = document.createElement('b');
        b.textContent = term.textContent;
        pop.replaceChildren(b, ' · ', term.dataset.gloss ?? '');
        place(term);
      }
      function hide() {
        pop.hidden = true;
        current = null;
      }
      const termOf = (t: EventTarget | null) => (t instanceof Element ? t.closest<HTMLElement>('a.term') : null);
      const within = (n: EventTarget | null, el: Element | null) => n instanceof Node && !!el?.contains(n);

      document.addEventListener('click', (e) => {
        const t = termOf(e.target);
        if (!t || e.detail === 0 || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return; // keyboard (Enter), screen-reader and modified clicks follow the link to the glossary
        e.preventDefault();
        show(t);
      });
      // pointerdown (not click) so a tap on plain prose also closes it on iOS
      document.addEventListener('pointerdown', (e) => {
        if (!termOf(e.target) && !within(e.target, pop)) hide();
      });
      document.addEventListener('pointerover', (e) => {
        const t = termOf(e.target);
        if (t && e.pointerType === 'mouse') show(t);
      });
      document.addEventListener('pointerout', (e) => {
        if (e.pointerType !== 'mouse' || !current) return;
        if (within(e.relatedTarget, pop) || within(e.relatedTarget, current)) return; // moving onto the pop-up keeps it open
        if (termOf(e.target) === current || within(e.target, pop)) hide();
      });
      document.addEventListener('focusin', (e) => {
        const t = termOf(e.target);
        if (t?.matches(':focus-visible')) show(t);
        else if (!t) hide();
      });
      addEventListener('blur', hide); // focus left the page; taps elsewhere are handled by pointerdown
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') hide();
      });
      addEventListener('resize', () => current && place(current));
    </script>
  </body>
</html>
